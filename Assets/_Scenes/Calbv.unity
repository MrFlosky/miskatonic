  json: '{"Options":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":463.500061,"yPos":113},"ID":5,"ParamActions":[],"TMPFontGUID":null,"Text":"Make
    a strange noise, barely audible from down the hall","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":7}],"EditorInfo":{"isRoot":false,"xPos":-31.50003,"yPos":158},"ID":6,"ParamActions":[],"TMPFontGUID":null,"Text":"Create
    a gust of wind that goes through her ","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":7}],"EditorInfo":{"isRoot":false,"xPos":-24.00003,"yPos":96},"ID":12,"ParamActions":[],"TMPFontGUID":null,"Text":"*Drip
    water her head*","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":444,"yPos":177},"ID":13,"ParamActions":[],"TMPFontGUID":null,"Text":"What
    could be beyond the darkness?","parentUIDs":[0],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":5},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":6},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":12},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":13}],"EditorInfo":{"isRoot":true,"xPos":209.5,"yPos":22},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Evenly
    flicks her head from side to side and sits up as soon as she awakes. She quickly
    pushes herself up. Standing now, she asses the situation. ","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Evelyn
    Ventress","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":59.49997,"yPos":282.000244},"ID":7,"ParamActions":[],"TMPFontGUID":null,"Text":"She
    ignores it, focusing all her attention to slowly moving down the hall. She gives
    her eyes the time to adjust to the dim light.","parentUIDs":[6,12],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Evelyn
    Ventress","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":395.500122,"yPos":261.000122},"ID":8,"ParamActions":[],"TMPFontGUID":null,"Text":"She
    tries to push the fear away from her mind, but she shakes as she begins to make
    her way though the damp maze. ","parentUIDs":[5,13],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Evelyn
    Ventress","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0}]}'
