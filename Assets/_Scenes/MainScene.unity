      propertyPath: m_LocalEulerAnglesHint.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4950557666849229629, guid: bb1074ffb16792e4a9319b6d2e820294, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4950557666849229629, guid: bb1074ffb16792e4a9319b6d2e820294, type: 3}
