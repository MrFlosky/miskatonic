    a strange noise, barely audible from down the hall","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":7}],"EditorInfo":{"isRoot":false,"xPos":-31.50003,"yPos":158},"ID":6,"ParamActions":[],"TMPFontGUID":null,"Text":"Create
    a gust of wind that goes through her ","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":7}],"EditorInfo":{"isRoot":false,"xPos":-24.00003,"yPos":96},"ID":12,"ParamActions":[],"TMPFontGUID":null,"Text":"*Drip
    water her head*","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":444,"yPos":177},"ID":13,"ParamActions":[],"TMPFontGUID":null,"Text":"What
    could be beyond the darkness?","parentUIDs":[0],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":5},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":6},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":12},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":13}],"EditorInfo":{"isRoot":true,"xPos":209.5,"yPos":22},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Evenly
